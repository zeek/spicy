module BenchmarkNested;

# Deep nested unit composition: fixed-size fields only.
type Leaf = unit {
    a: uint8;
    b: uint8;
};

type Inner = unit {
    x: Leaf;
    y: Leaf;
};

type Middle = unit {
    m: Inner;
    n: uint16;
};

public type UnitNested = unit {
    length: uint64;
    items: Middle[] &size=self.length;
};

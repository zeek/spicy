# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -P "" -o Foo.h
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -j driver.cc >output
# @TEST-EXEC: btest-diff output
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -g -j driver.cc >unoptimized
# @TEST-EXEC: cmp output unoptimized
# @TEST-EXEC: spicyc %INPUT --strict-public-api -P "" -o Legacy.h
# @TEST-EXEC: spicyc %INPUT --strict-public-api -j legacy-driver.cc >legacy
# @TEST-EXEC: cmp output legacy
# @TEST-EXEC: spicyc %INPUT --experimental-pir -p -D spicy-pir 2>&1 >/dev/null | rg "attached PIR-produced" >route
# @TEST-EXEC: btest-diff route

# @TEST-DOC: Executes `print` through PIR's runtime calls. It covers an empty statement, single values of
# each supported type, and several values printed as one tuple, including an operand computed by a Spicy
# helper, and checks that each operand is evaluated once and in order. The output matches the legacy build
# both optimized and unoptimized.

module Test;

function note(x: int64): int64 {
    print "note", x;
    return x;
}

function double(x: int64): int64 {
    return x + x;
}

public function show(): void {
    print;
    print -42;
    print True;
    print "text";
    print b"bytes";
    print "several", -7, False, double(note(-3));
    print note(-1), note(-2);
}

@TEST-START-FILE driver.cc

#include <iostream>

#include <hilti/rt/libhilti.h>
#include <spicy/rt/libspicy.h>

#include "Foo.h"

extern "C" int HILTI_EXPORT hilti_main() {
    hlt::_r__spicy_pir_backend::show();
    return 0;
}

int main(int argc, char** argv) {
    hilti::rt::init();
    spicy::rt::init();
    hilti_main();
    hilti::rt::done();
    return 0;
}

@TEST-END-FILE

@TEST-START-FILE legacy-driver.cc

#include <iostream>

#include <hilti/rt/libhilti.h>
#include <spicy/rt/libspicy.h>

#include "Legacy.h"

extern "C" int HILTI_EXPORT hilti_main() {
    hlt_internal::Test::show();
    return 0;
}

int main(int argc, char** argv) {
    hilti::rt::init();
    spicy::rt::init();
    hilti_main();
    hilti::rt::done();
    return 0;
}

@TEST-END-FILE

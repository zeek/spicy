# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -P "" -o Foo.h
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -j driver.cc >output
# @TEST-EXEC: btest-diff output
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -g -j driver.cc >unoptimized
# @TEST-EXEC: cmp output unoptimized
# @TEST-EXEC: spicyc %INPUT --experimental-pir -p -D spicy-pir 2>&1 >/dev/null | rg "attached PIR-produced" >route
# @TEST-EXEC: btest-diff route

# @TEST-DOC: Runs `%done` hooks of a public unit through PIR. Two hooks observe the same completed unit:
# the higher priority runs first and reads a field, and the other hook reads a field and a bytes field
# after it. The parser is driven with an input containing one complete message.

module Test;

public type Message = unit {
    length: uint64;
    tail: bytes &size=3;
};

on Message::%done { print "done", self.length, self.tail; }
on Message::%done priority=5 { print "first", self.length; }

@TEST-START-FILE driver.cc

#include <iostream>

#include <hilti/rt/libhilti.h>
#include <spicy/rt/libspicy.h>

#include "Foo.h"

extern "C" int HILTI_EXPORT hilti_main() {
    const char input[] = {0, 0, 0, 0, 0, 0, 0, 2, 'E', 'N', 'D'};
    auto stream = hilti::rt::reference::make_value<hilti::rt::Stream>(hilti::rt::Bytes(input, sizeof(input)));
    stream->freeze();
    hlt::_r__spicy_pir_backend::parse_root_0(stream, {});
    return 0;
}

int main(int argc, char** argv) {
    hilti::rt::init();
    spicy::rt::init();
    hilti_main();
    hilti::rt::done();
    return 0;
}

@TEST-END-FILE

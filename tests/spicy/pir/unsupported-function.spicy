# @TEST-EXEC: spicyc %INPUT -p --experimental-pir -D spicy-pir >/dev/null 2>on.log
# @TEST-EXEC: btest-diff on.log

# @TEST-DOC: Tests that a public function outside PIR's accepted subset is reported precisely and
# that compilation still falls back to the standard code generator.

module Test;

public function countdown(x: int64): int64 {
    local y: int64 = x;

    while ( y < -10 ) {
        y = y + -1;
    }

    return y;
}

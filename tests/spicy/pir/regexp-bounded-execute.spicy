# @TEST-EXEC: cp ${SCRIPTS}/pir-parse.h parse.h
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -p -D spicy-pir >/dev/null 2>pir.log
# @TEST-EXEC: rg "attached PIR-produced|parser.match_regexp" pir.log | sort -u >route
# @TEST-EXEC: btest-diff route
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -j driver.cc >output
# @TEST-EXEC: btest-diff output
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -g -j driver.cc >unoptimized
# @TEST-EXEC: cmp output unoptimized
# @TEST-EXEC: spicyc %INPUT -j driver.cc >legacy
# @TEST-EXEC: cmp output legacy

# @TEST-DOC: A regular expression inside a byte-bounded vector element sees the bound as the end of input: the match stops there, and a pattern that needs more bytes fails as in legacy, whole and one byte at a time.

module Test;

type Item = unit {
    tag: /[a-z]+/;
    value: uint8;
};

public type Message = unit {
    length: uint64;
    items: Item[] &size=self.length;
    end_: b"END";

    on %done {
        print "done", self.length, |self.items|;
    }
};

public type Greedy = unit {
    length: uint64;
    items: Item[] &size=self.length;

    on %done {
        print "done", self.length, |self.items|;
    }
};

@TEST-START-FILE driver.cc
static constexpr unsigned error_style = 1;
#include "parse.h"

extern "C" int HILTI_EXPORT hilti_main() {
    auto both = [](const char* unit, const char* label, const std::string& input) {
        run(unit, label, {{input}});
        run(unit, (std::string(label) + "-chunked").c_str(), {{input}}, 1);
    };

    both("Test::Message", "match", be64(6) + "ab\x01" "cd\x02" "END");
    both("Test::Message", "bound-ends-match", be64(3) + "ab\x01" "abcEND");
    both("Test::Message", "bound-cuts-pattern", be64(2) + "abcd\x01" "END");
    both("Test::Message", "bound-before-value", be64(2) + "ab\x01" "END");
    both("Test::Message", "empty-bound", be64(0) + "END");
    both("Test::Message", "no-pattern-start", be64(2) + "1\x01" "END");
    both("Test::Greedy", "greedy", be64(3) + "ab\x01" "xyz");
    return 0;
}

@TEST-END-FILE

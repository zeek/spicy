# @TEST-EXEC: spicyc %INPUT -p --experimental-pir -D spicy-pir >/dev/null 2>on.log
# @TEST-EXEC: btest-diff on.log

# @TEST-DOC: A look-ahead switch with a token that is not a bytes literal falls back to the standard code generator.

module Test;

public type Message = unit {
    switch {
        -> a: /A/;
        -> b: b"B";
    };
};

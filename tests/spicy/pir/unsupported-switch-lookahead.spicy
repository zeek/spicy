# @TEST-EXEC: spicyc %INPUT -p --experimental-pir -D spicy-pir >/dev/null 2>on.log
# @TEST-EXEC: btest-diff on.log

# @TEST-DOC: A look-ahead switch, which has no control expression, falls back to the standard code generator.

module Test;

public type Message = unit {
    switch {
        -> a: b"A";
        -> b: b"B";
    };
};

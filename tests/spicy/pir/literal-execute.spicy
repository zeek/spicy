# @TEST-EXEC: cp ${SCRIPTS}/pir-parse.h parse.h
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -p -D spicy-pir >/dev/null 2>pir.log
# @TEST-EXEC: rg "attached PIR-produced|parser.expect_bytes" pir.log | sort -u >route
# @TEST-EXEC: btest-diff route
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -j driver.cc >output
# @TEST-EXEC: btest-diff output
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -g -j driver.cc >unoptimized
# @TEST-EXEC: cmp output unoptimized
# @TEST-EXEC: spicyc %INPUT -j driver.cc >legacy
# @TEST-EXEC: cmp output legacy

# @TEST-DOC: Parses bytes literals: a named one whose hook receives it as `$$`, an anonymous one, and one after a
# vector. Matching, mismatching, short, and crossing-the-bound inputs behave and fail as in legacy, whole and one byte
# at a time.

module Test;

type Item = unit {
    tag: b"I";
    value: uint8;
};

public type Message = unit {
    start: b"BEGIN" {
        print "start", $$;
    }
    : b"--";
    length: uint64;
    items: Item[] &size=self.length;
    end_: b"END";

    on %done {
        print "done", self.start, self.end_;
    }
};

@TEST-START-FILE driver.cc
static constexpr unsigned error_style = 1;
#include "parse.h"

extern "C" int HILTI_EXPORT hilti_main() {
    const std::string head = "BEGIN--";
    const std::string items = "I\x01I\x02";
    const std::vector<std::pair<const char*, std::string>> rows = {
        {"match", head + be64(4) + items + "END"},
        {"mismatch-start", "BEGXN--" + be64(0) + "END"},
        {"mismatch-end", head + be64(0) + "ENX"},
        {"short-end", head + be64(0) + "EN"},
        {"mismatch-in-vector", head + be64(4) + "I\x01X\x02" + "END"},
        {"crossing-bound", head + be64(1) + "I\x01" + "END"},
    };
    for ( const auto& [label, input] : rows ) {
        run("Test::Message", label, {{input}});
        run("Test::Message", (std::string(label) + "-chunked").c_str(), {{input}}, 1);
    }
    return 0;
}

@TEST-END-FILE

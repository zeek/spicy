# @TEST-EXEC: spicyc %INPUT -p --experimental-pir -D spicy-pir >/dev/null 2>on.log
# @TEST-EXEC: btest-diff on.log

# @TEST-DOC: Tests that a public unit with more than one field is reported precisely and that
# compilation still falls back to the standard code generator.

module Test;

public type TwoFields = unit {
    a: uint8;
    b: uint8;
};

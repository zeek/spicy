# @TEST-EXEC: cp ${SCRIPTS}/pir-parse.h parse.h
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -p -D spicy-pir >/dev/null 2>pir.log
# @TEST-EXEC: rg "attached PIR-produced" pir.log >route
# @TEST-EXEC: btest-diff route
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -j driver.cc >output
# @TEST-EXEC: btest-diff output
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -g -j driver.cc >unoptimized
# @TEST-EXEC: cmp output unoptimized
# @TEST-EXEC: spicyc %INPUT -j driver.cc >legacy
# @TEST-EXEC: sed '/^gap-in-bytes/s/ (.*)$//' output >output.cmp
# @TEST-EXEC: sed '/^gap-in-bytes/s/ (.*)$//' legacy >legacy.cmp
# @TEST-EXEC: cmp output.cmp legacy.cmp

# @TEST-DOC: A gap inside an integer, a bytes field, and a sub-unit fails with the exception type, text, and location of
# legacy. For a gap in bytes, legacy reports the location of the field's type, but of the whole field when the input
# ends early, and PIR reports the field's for both; that location is not compared.

module Test;

type Child = unit {
    a: uint16;
};

public type Message = unit {
    i: uint32;
    b: bytes &size=4;
    c: Child;
};

@TEST-START-FILE driver.cc
static constexpr unsigned error_style = 2;
#include "parse.h"

extern "C" int HILTI_EXPORT hilti_main() {
    run("Test::Message", "gap-in-integer", {{std::string("\x01\x02", 2)}, {"", 1}, {std::string("\x04" "abcd" "\x00\x01", 7)}});
    run("Test::Message", "gap-in-bytes", {{std::string("\x01\x02\x03\x04" "ab", 6)}, {"", 1}, {std::string("d" "\x00\x01", 3)}});
    run("Test::Message", "gap-in-child", {{std::string("\x01\x02\x03\x04" "abcd" "\x00", 9)}, {"", 1}});
    return 0;
}

@TEST-END-FILE

# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -P "" -o Foo.h
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -j driver.cc >output
# @TEST-EXEC: btest-diff output
# @TEST-EXEC: spicyc %INPUT --experimental-pir -p -D spicy-pir 2>&1 >/dev/null | rg "attached PIR-produced" >route
# @TEST-EXEC: btest-diff route

# @TEST-DOC: Executes a native function that takes an `any` argument by pointer through PIR. The native
# side receives the argument's storage and its runtime type information, as the `&cxx-any-as-ptr` convention
# specifies.

module Test;

function observe(x: any &cxx-any-as-ptr) &cxxname="observe";

public function answer(): int64 {
    observe(-42);
    return 42;
}

@TEST-START-FILE driver.cc

#include <iostream>

#include <hilti/rt/libhilti.h>
#include <spicy/rt/libspicy.h>

#include "Foo.h"

void observe(const void* value, const hilti::rt::TypeInfo* type) {
    std::cout << "observe: " << (value != nullptr) << " " << type->display << std::endl;
}

extern "C" int HILTI_EXPORT hilti_main() {
    auto r = hlt::_r__spicy_pir_backend::answer();
    std::cout << "answer: " << r.get<hilti::rt::integer::safe<int64_t>>() << std::endl;
    return 0;
}

int main(int argc, char** argv) {
    hilti::rt::init();
    spicy::rt::init();
    hilti_main();
    hilti::rt::done();
    return 0;
}

@TEST-END-FILE

# @TEST-EXEC: btest-diff on.log

# @TEST-DOC: A context that is not a tuple of named integers falls back.

module Test;

type Names = tuple<names: vector<bytes>>;

public type Holder = unit {
    %context = Names;
    value: uint8;
};

# @TEST-EXEC: spicyc %INPUT -p --experimental-pir -D spicy-pir >/dev/null 2>on.log
# @TEST-EXEC: btest-diff on.log

# @TEST-DOC: Tests that reading a mutable native library value twice prevents selection of the PIR-only route,
# because the first read moves the value and the second would copy it, which the native type does not allow. The
# legacy generator retains the copy.

module Test;

type Handle = __library_type("hilti::rt::TypeInfo*");

function make_handle(): Handle &cxxname="make_handle";
function consume(h: Handle) &cxxname="consume";

public function answer(): int64 {
    local h = make_handle();
    consume(h);
    consume(h);
    return 42;
}

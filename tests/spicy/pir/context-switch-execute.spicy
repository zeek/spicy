# @TEST-DOC: A context tuple projection used as a switch control lowers as an ordinary tuple,
# including the case branch. It must execute through PIR without a backend exception.

module Test;

type Context = tuple<n: uint8>;

public type Message = unit {
    %context = Context;
    on %init { self.context().n = 1; }
    switch ( self.context().n ) {
        1 -> value: uint8;
        * -> other: uint16;
    };
    on %done { print self.value; }
};

@TEST-START-FILE flows.dat
!spicy-batch v2
@begin-flow first stream Test::Message
@begin-flow second stream Test::Message
@data first 1
A
@gap second 1
@end-flow first
@end-flow second
@TEST-END-FILE

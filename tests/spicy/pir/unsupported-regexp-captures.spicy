# @TEST-EXEC: spicyc %INPUT -p --experimental-pir -D spicy-pir >/dev/null 2>on.log
# @TEST-EXEC: btest-diff on.log

# @TEST-DOC: A hook that uses the captures of a regular expression falls back to the standard code generator.

module Test;

public type Message = unit {
    data: /(a+)(b+)/ {
        print $1, $2;
    }
};

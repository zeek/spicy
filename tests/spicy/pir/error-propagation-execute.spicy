# @TEST-DOC: A failure three sub-units deep reports the innermost operation's description and location.

module Test;

type Leaf = unit {
    a: uint8;
    b: uint32;
};

type Inner = unit {
    leaf: Leaf;
};

type Middle = unit {
    inner: Inner;
};

public type Outer = unit {
    middle: Middle;
};

@TEST-START-FILE inputs.py
typed = True
cases = [("Test::Outer", "deep", b"\x01\x02\x03")]
@TEST-END-FILE

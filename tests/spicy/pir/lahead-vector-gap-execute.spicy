# @TEST-EXEC: cp ${SCRIPTS}/pir-parse.h parse.h
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -p -D spicy-pir >/dev/null 2>pir.log
# @TEST-EXEC: rg "attached PIR-produced|falling back" pir.log | sort -u >route
# @TEST-EXEC: btest-diff route
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -j driver.cc >output
# @TEST-EXEC: btest-diff output
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -g -j driver.cc >unoptimized
# @TEST-EXEC: cmp output unoptimized
# @TEST-EXEC: spicyc %INPUT -j driver.cc >legacy
# @TEST-EXEC: sed -E '/^gap-(at-peek|after-peek-byte)/s/ \(.*\)$//' output >output.cmp
# @TEST-EXEC: sed -E '/^gap-(at-peek|after-peek-byte)/s/ \(.*\)$//' legacy >legacy.cmp
# @TEST-EXEC: cmp output.cmp legacy.cmp

# @TEST-DOC: A gap at the look-ahead fails with the exception type and text of legacy. After an element, legacy reports the location of that element's last field, since its look-ahead does not set one, and PIR reports the vector field's; those locations are not compared.

module Test;

type Item = unit {
    a: b"A";
};

public type Message = unit {
    items: Item[];
    end_: b"END";
};

@TEST-START-FILE driver.cc
static constexpr unsigned error_style = 2;
#include "parse.h"

extern "C" int HILTI_EXPORT hilti_main() {
    run("Test::Message", "gap-at-peek", {{"AA"}, {"", 1}, {"AEND"}});
    run("Test::Message", "gap-at-start", {{"", 2}, {"AEND"}});
    run("Test::Message", "gap-after-peek-byte", {{"AAE"}, {"", 1}, {"D"}});
    run("Test::Message", "no-gap", {{"AAEND"}});
    return 0;
}

@TEST-END-FILE

# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -P "" -o Foo.h
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -j driver.cc >output
# @TEST-EXEC: btest-diff output
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -g -j driver.cc >unoptimized
# @TEST-EXEC: cmp output unoptimized
# @TEST-EXEC: spicyc %INPUT --strict-public-api -P "" -o Legacy.h
# @TEST-EXEC: spicyc %INPUT --strict-public-api -j legacy-driver.cc >legacy
# @TEST-EXEC: cmp output legacy
# @TEST-EXEC: spicyc %INPUT --experimental-pir -p -D spicy-pir 2>&1 >/dev/null | rg "attached PIR-produced" >route
# @TEST-EXEC: btest-diff route

# @TEST-DOC: Executes early returns nested inside guards through PIR. An inner `return` cuts across the
# outer join, which the backend must still emit with each block once. Every combination of arguments
# reaches each exit, and the output matches the legacy build both optimized and unoptimized. The route
# check proves that PIR, not the standard generator, produced the module.

module Test;

public function nested(a: bool, b: bool): int64 {
    if ( a ) {
        if ( b ) {
            return 1;
        }
    }

    return 2;
}

public function branchy(a: bool, b: bool, c: bool): int64 {
    if ( a ) {
        if ( b ) {
            return 1;
        }

        if ( c ) {
            return 3;
        }
    }
    else {
        if ( c ) {
            return 4;
        }
    }

    return 2;
}

@TEST-START-FILE driver.cc

#include <iostream>

#include <hilti/rt/libhilti.h>
#include <spicy/rt/libspicy.h>

#include "Foo.h"

using Int = hilti::rt::integer::safe<int64_t>;

extern "C" int HILTI_EXPORT hilti_main() {
    for ( bool a : {false, true} ) {
        for ( bool b : {false, true} ) {
            auto n = hlt::_r__spicy_pir_backend::nested(a, b);
            std::cout << "nested " << a << " " << b << " = " << n.get<Int>() << std::endl;

            for ( bool c : {false, true} ) {
                auto r = hlt::_r__spicy_pir_backend::branchy(a, b, c);
                std::cout << "branchy " << a << " " << b << " " << c << " = " << r.get<Int>() << std::endl;
            }
        }
    }

    return 0;
}

int main(int argc, char** argv) {
    hilti::rt::init();
    spicy::rt::init();
    hilti_main();
    hilti::rt::done();
    return 0;
}

@TEST-END-FILE

@TEST-START-FILE legacy-driver.cc

#include <iostream>

#include <hilti/rt/libhilti.h>
#include <spicy/rt/libspicy.h>

#include "Legacy.h"

extern "C" int HILTI_EXPORT hilti_main() {
    for ( bool a : {false, true} ) {
        for ( bool b : {false, true} ) {
            auto n = hlt_internal::Test::nested(a, b);
            std::cout << "nested " << a << " " << b << " = " << n << std::endl;

            for ( bool c : {false, true} ) {
                auto r = hlt_internal::Test::branchy(a, b, c);
                std::cout << "branchy " << a << " " << b << " " << c << " = " << r << std::endl;
            }
        }
    }

    return 0;
}

int main(int argc, char** argv) {
    hilti::rt::init();
    spicy::rt::init();
    hilti_main();
    hilti::rt::done();
    return 0;
}

@TEST-END-FILE

# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -p -D spicy-pir >/dev/null 2>pir.log
# @TEST-EXEC: sed -n '/after constant folding:/,$p' pir.log | rg "core.switch|core.jump|core.phi|core.upsilon|parser.read_integer|block %" >folded
# @TEST-EXEC: btest-diff folded

# @TEST-DOC: A switch whose control expression folds to a constant becomes a jump to its case, and the other cases
# are erased with the Upsilons that wrote into the merge.

module Test;

public type Message = unit {
    switch ( 1 + 1 ) {
        1 -> a: uint8;
        2 -> b: uint16;
        * -> c: uint32;
    };
};

# @TEST-EXEC: cp ${SCRIPTS}/pir-parse.h parse.h
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -p -D spicy-pir >/dev/null 2>pir.log
# @TEST-EXEC: rg "attached PIR-produced|parser.read_integer|core.int_constant" pir.log | sort -u >route
# @TEST-EXEC: btest-diff route
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -j driver.cc >output
# @TEST-EXEC: btest-diff output
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -g -j driver.cc >unoptimized
# @TEST-EXEC: cmp output unoptimized
# @TEST-EXEC: spicyc %INPUT -j driver.cc >legacy
# @TEST-EXEC: cmp output legacy

# @TEST-DOC: All 256 byte patterns retain their unsigned and signed values in root and nested fields,
# with whole and bytewise input. Empty, truncated, and gapped reads match legacy failures.

module Test;

type Child = unit {
    u: uint8;
    i: int8;
};

public type Bytes = unit {
    u: uint8;
    i: int8;
    child: Child;

    on %done {
        print self.u, self.i, self.child.u, self.child.i;
    }
};

@TEST-START-FILE driver.cc
static constexpr unsigned error_style = 2;
#include "parse.h"

extern "C" int HILTI_EXPORT hilti_main() {
    for ( unsigned byte = 0; byte < 256; ++byte ) {
        const auto input = std::string(4, static_cast<char>(byte));
        run("Test::Bytes", "whole", {{input}});
        run("Test::Bytes", "bytewise", {{input}}, 1);
    }
    for ( size_t offset = 0; offset < 4; ++offset ) {
        const auto prefix = std::string(offset, '\xff');
        run("Test::Bytes", "eod", {{prefix}});
        run("Test::Bytes", "gap", {{prefix}, {"", 1}, {std::string(3 - offset, '\x80')}});
    }
    return 0;
}

@TEST-END-FILE

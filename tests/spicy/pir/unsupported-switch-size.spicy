# @TEST-EXEC: spicyc %INPUT -p --experimental-pir -D spicy-pir >/dev/null 2>on.log
# @TEST-EXEC: btest-diff on.log

# @TEST-DOC: A switch with `&size` falls back to the standard code generator.

module Test;

public type Message = unit {
    tag: uint8;
    switch ( self.tag ) {
        1 -> a: uint8;
        * -> b: uint8;
    } &size=1;
};

# @TEST-EXEC: cp ${SCRIPTS}/pir-parse.h parse.h
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -p -D spicy-pir >/dev/null 2>pir.log
# @TEST-EXEC: rg "attached PIR-produced|core.convert" pir.log | sort -u >route
# @TEST-EXEC: btest-diff route
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -j driver.cc >output
# @TEST-EXEC: btest-diff output
# @TEST-EXEC: spicyc %INPUT --experimental-pir --strict-public-api -g -j driver.cc >unoptimized
# @TEST-EXEC: cmp output unoptimized
# @TEST-EXEC: spicyc %INPUT -j driver.cc >legacy
# @TEST-EXEC: cmp output legacy

# @TEST-DOC: Lowers the frontend's integer coercions to explicit conversions: widening for a function
# argument and a local of a wider signed type, and an integer used as a condition. The output matches the
# legacy build.

module Test;

function widen(x: uint64): uint64 {
    return x;
}

public type X = unit {
    small: uint8;
    signed_: int8;

    on %done {
        if ( self.small )
            print "nonzero", widen(self.small);
        else
            print "zero", widen(self.small);

        local wide: int32 = self.small;
        local wide_signed: int64 = self.signed_;
        print wide, wide_signed;
    }
};

@TEST-START-FILE driver.cc
static constexpr unsigned error_style = 0;
#include "parse.h"

extern "C" int HILTI_EXPORT hilti_main() {
    run("Test::X", "nonzero", {{std::string("\xfe\xfe", 2)}});
    run("Test::X", "zero", {{std::string("\x00\x05", 2)}});
    return 0;
}

@TEST-END-FILE

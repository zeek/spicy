# @TEST-EXEC: ${SCRIPTS}/printf '\x01\x01\x00' | spicy-driver -i 1 -p Test::Node %INPUT >output.ok 2>&1
# @TEST-EXEC: grep -q 'Node' output.ok
# @TEST-EXEC-FAIL: ${SCRIPTS}/printf '\x01\x01\x01\x00' | spicy-driver -i 1 -p Test::Node %INPUT >output.fail 2>&1
# @TEST-EXEC: grep -q 'parse recursion depth 4 exceeds configured limit 3' output.fail
# @TEST-EXEC-FAIL: ${SPICYC} -p zero.spicy >output.zero 2>&1
# @TEST-EXEC: grep -q 'must be greater than zero' output.zero
#
# @TEST-DOC: Checks the configured recursion limit across incremental parsing.

module Test;

%parse-recursion-depth = 3;

public type Node = unit {
    tag: uint8;
    child: Node if (self.tag > 0);

    on %done { print self; }
};

# @TEST-START-FILE zero.spicy

module TestZero;

%parse-recursion-depth = 0;

# @TEST-END-FILE

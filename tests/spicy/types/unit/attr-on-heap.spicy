# @TEST-REQUIRES: which FileCheck
# @TEST-EXEC: spicyc -p %INPUT -o output.hlt
# @TEST-EXEC: FileCheck %INPUT < output.hlt
#
# @TEST-DOC: Test that `&on-heap` on a unit type causes the generated HILTI struct to carry `&on-heap`.

module foo;

type Inner2 = unit {
    x: uint8;
} &on-heap;

# CHECK: type Inner2 = struct {
# CHECK: } &on-heap;
public type Outer2 = unit {
    f: Inner2;
};

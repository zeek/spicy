# @TEST-DOC: Synchronization after a nested unit trims all currently available input must wait for more data.
# @TEST-EXEC: spicyc -j -d %INPUT -o test.hlto
# @TEST-EXEC: ${SCRIPTS}/printf 'ABxx\002\001ABqq\005\000zzABcc\002\001' | spicy-driver -i 1 test.hlto >output
# @TEST-EXEC: btest-diff output

module Test;

public type Messages = unit {
    : (Message &synchronize)[];
};

type Message = unit {
    %synchronize-at = b"AB";

    magic: b"AB";
    payload: bytes &size=2;
    kind: uint8 { confirm; }
    check: uint8 &requires=($$ == 1);

    on %done { print "message", self.payload; }
};
